{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Agent(builder-strong)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push *+refs/heads/*)",
      "Bash(git push *refs/heads/*:refs/heads/*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *+main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push origin --delete*)",
      "Bash(git push origin :*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(*prisma db push*)",
      "Bash(*drizzle-kit push*)",
      "Bash(*prisma migrate reset*)",
      "Bash(*prisma db seed*)",
      "Bash(*supabase db reset*)",
      "Bash(*db:push*)",
      "Bash(*db:reset*)",
      "Bash(*db:seed*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-handoff.mjs\" usage",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-handoff.mjs\" compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
