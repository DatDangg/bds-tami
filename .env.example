# TAMI website — mẫu biến môi trường. Sao chép thành .env.local và điền giá trị.
# KHÔNG commit .env / .env.local. Danh sách bắt buộc: .context/project-config.md § Secrets.
# Giá trị dưới đây khớp docker/docker-compose.dev.yml (chỉ dùng dev local).

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgres://tami:tami_dev_password@127.0.0.1:5433/tami
# DB dùng cho integration test (có thể trùng DATABASE_URL ở dev; CI dùng DB riêng). Tuỳ chọn.
DATABASE_URL_TEST=postgres://tami:tami_dev_password@127.0.0.1:5433/tami

# Payload: chuỗi ngẫu nhiên dài (vd `openssl rand -hex 32`)
PAYLOAD_SECRET=

# Redis
REDIS_URL=redis://127.0.0.1:6381

# Object storage (SeaweedFS S3 API) — khớp docker/seaweedfs/s3.json
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY_ID=tami-dev-access
S3_SECRET_ACCESS_KEY=tami-dev-secret-not-for-prod
S3_BUCKET_PUBLIC=public
S3_BUCKET_PRIVATE=private

# Cloudflare Turnstile (dev: dùng key test công khai của Cloudflare)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP (Brevo)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# Brevo: cổng 587 (STARTTLS, mặc định); 465 = TLS ngay từ đầu.
SMTP_PORT=587
# Địa chỉ người gửi (sender đã xác minh ở Brevo); bỏ trống thì dùng SMTP_USER.
EMAIL_FROM_ADDRESS=
# development | test | staging | production. Khác production thì chỉ gửi email tới EMAIL_ALLOWLIST (ARCHITECTURE §6.3).
# BẮT BUỘC đặt APP_ENV=production trên prod, nếu không email bị chặn.
APP_ENV=development
# Email nội bộ, ngăn cách bằng dấu phẩy (chỉ có tác dụng khi APP_ENV khác production).
EMAIL_ALLOWLIST=

# Dịch VI -> EN bằng Claude API (BR-08). Chỉ đọc phía server, KHÔNG đặt NEXT_PUBLIC_*, không log. Prod/staging dùng key riêng.
# Để trống ANTHROPIC_API_KEY thì app vẫn chạy, chỉ việc dịch báo lỗi "not_configured". Test không bao giờ cần key thật (SDK được mock).
ANTHROPIC_API_KEY=
# Chuỗi model đúng như API, không thêm hậu tố ngày. Model có giá trong bảng: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5,
# claude-opus-5, claude-sonnet-5, claude-haiku-4-5 (lib/translation/budget.ts). Model khác tính theo mức giá cao nhất (bảo thủ).
TRANSLATION_MODEL=claude-opus-5-5
# Hạn mức chi phí ước tính mỗi tháng (USD, tháng theo UTC). Chạm hạn mức thì dừng dịch (budget_exceeded). 0 = tắt dịch. Staging nên đặt thấp.
TRANSLATION_MONTHLY_BUDGET_USD=0

# URL công khai của site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hotline hiện ở trang lỗi 500 (global-error không đọc được DB). Biến build: đổi giá trị thì phải build lại.
NEXT_PUBLIC_HOTLINE=

# Chỉ đặt `true` khi app chạy sau Nginx đã giới hạn nguồn vào dải IP Cloudflare (khi đó mới tin CF-Connecting-IP).
# Mặc định / dev: không đặt (hoặc false) -> không tin header, rate limit dùng chung 1 bucket nếu không có remote address.
TRUST_CF_CONNECTING_IP=false

# Giám sát (ARCHITECTURE §8). Để trống = tắt GlitchTip (không gửi gì ra ngoài).
# DSN server và DSN trình duyệt đều đọc LÚC CHẠY (trình duyệt lấy qua GET /api/monitoring-config), không nhúng vào bundle: cùng 1 image promote staging -> prod.
# DSN trình duyệt vốn công khai; dùng chung 1 project GlitchTip với DSN server được.
GLITCHTIP_DSN=
GLITCHTIP_PUBLIC_DSN=
# Bearer token cho GET /api/metrics (Prometheus), >= 32 ký tự: `openssl rand -hex 32`. Để trống = endpoint tắt (404).
# Nginx KHÔNG được public đường /api/metrics; Prometheus scrape qua 127.0.0.1 hoặc network nội bộ.
METRICS_TOKEN=
# Mức log pino: fatal|error|warn|info|debug|trace|silent (mặc định info; chạy test = silent).
LOG_LEVEL=info

# ───────────────────────────────────────────────────────────────────────────────
# Docker Compose staging/prod (docker/docker-compose.staging.yml, docker/docker-compose.prod.yml)
# Mỗi môi trường có 1 env file RIÊNG trên server (vd /opt/tami/staging.env, /opt/tami/prod.env), quyền 600, KHÔNG commit,
# truyền bằng `docker compose --env-file`. Dùng đúng các biến ở trên (S3_*, SMTP_*, TURNSTILE_*, ANTHROPIC_*, ...) với giá trị
# riêng từng môi trường, cộng các biến dưới đây. Compose tự đặt: APP_ENV, TRUST_CF_CONNECTING_IP=true, S3_ENDPOINT, REDIS_URL.
# staging và prod PHẢI khác nhau ở DATABASE_URL_*, POSTGRES_PASSWORD, REDIS_PASSWORD, S3_*, S3_BUCKET_*, PAYLOAD_SECRET.
# ───────────────────────────────────────────────────────────────────────────────
# Image đã build (tag theo commit SHA); promote prod dùng đúng tag đã chạy ở staging.
TAMI_IMAGE=tami-web:<git-sha>
# Container postgres. Mật khẩu: `openssl rand -hex 24` (chỉ hex để nhúng được vào URL).
POSTGRES_USER=tami
POSTGRES_PASSWORD=
POSTGRES_DB=tami
# Chuỗi kết nối app dùng (host `postgres` trong network compose, cùng user/mật khẩu/db ở trên). Staging dùng _STAGING, prod dùng _PROD.
# Ví dụ dưới giống nhau chỉ vì host `postgres` resolve tới instance Postgres RIÊNG của từng compose project (network `tami-net` / `tami-staging-net`);
# giá trị thật vẫn phải khác nhau ở mật khẩu (POSTGRES_PASSWORD riêng mỗi env file), nên chuỗi DATABASE_URL_STAGING ≠ DATABASE_URL_PROD.
DATABASE_URL_STAGING=postgres://tami:<POSTGRES_PASSWORD>@postgres:5432/tami
DATABASE_URL_PROD=postgres://tami:<POSTGRES_PASSWORD>@postgres:5432/tami
# Mật khẩu Redis trong compose: `openssl rand -hex 24`.
REDIS_PASSWORD=
# Bucket (SeaweedFS riêng mỗi môi trường), vd staging: tami-staging-public/tami-staging-private; prod: tami-prod-public/tami-prod-private.
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY cũng là khoá admin do compose đặt cho SeaweedFS: tự sinh bằng `openssl rand -hex 16/32`.
# Backup (pgBackRest + restic, kho NGOÀI server): thư mục trên server chứa `pgbackrest.env`, `restic.env` (chmod 600, mẫu docker/backup/*-env.example)
# và `ssh/` (khoá SFTP, known_hosts, CA; chown 999:999). Bắt buộc: thiếu thì `docker compose config` lỗi. Mỗi môi trường một thư mục riêng.
# Chi tiết thiết lập/khôi phục: docs/runbooks/restore.md.
BACKUP_ENV_DIR=/opt/tami/backup/staging
# (Tuỳ chọn) Trần WAL chưa lên kho của pgBackRest; mặc định staging 4GiB / prod 8GiB. Vượt trần thì BỎ WAL (gãy PITR, cần full mới) thay vì đầy ổ server dùng chung: restore.md §9.
# BACKUP_ARCHIVE_PUSH_QUEUE_MAX=4GiB
# Staging bắt buộc có EMAIL_ALLOWLIST (email nội bộ). NEXT_PUBLIC_SITE_URL: https://staging.<domain> hoặc https://<domain>.
# Migrate là bước riêng: `compose --profile tools run --rm migrate`. App/jobs KHÔNG tự migrate lúc khởi động ở production
# (payload.config.ts chỉ bật prodMigrations khi AUTO_MIGRATE_ON_START=true; compose không truyền biến này, đừng bật trên prod).

# Source map trình duyệt lên GlitchTip (chỉ dùng lúc BUILD release; không cần ở runtime). Để trống GLITCHTIP_AUTH_TOKEN = không sinh, không upload.
# Có token thì phải có đủ URL/ORG/PROJECT, nếu không build dừng. Token tạo ở GlitchTip (Profile > Auth Tokens, quyền project:write).
# CI: GLITCHTIP_AUTH_TOKEN là GitHub secret, GLITCHTIP_URL/ORG/PROJECT là GitHub vars (docs/runbooks/deploy.md mục 8).
GLITCHTIP_AUTH_TOKEN=
GLITCHTIP_URL=
GLITCHTIP_ORG=
GLITCHTIP_PROJECT=
